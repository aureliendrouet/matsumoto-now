---
import Base from '../../layouts/Base.astro';
import { useTranslations, langParams, asLang, localePath } from '../../i18n/utils';
import { features } from '../../features';

export function getStaticPaths() {
  return langParams;
}

const lang = asLang(Astro.params.lang);
const t = useTranslations(lang);
---

<Base lang={lang} title={t('nav.dashboard')} active="dashboard">
  <div class="grid">
    {
      features.warnings && (
        <section id="warnings" class="banner ok col-12" aria-live="polite" data-widget="warnings">
          <p class="placeholder" style="padding: 0">
            {t('common.loading')}
          </p>
        </section>
      )
    }

    {
      features.currentConditions && (
        <section class="card col-5">
          <div class="card-head">
            <h2>{t('now.title')}</h2>
            <span class="updated" data-now-updated />
          </div>
          <p class="card-sub">{t('now.station')}</p>
          <div data-widget="now">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }

    {
      features.hourlyTemperature && (
        <section class="card col-7">
          <div class="card-head">
            <h2>{t('forecast.hourly')}</h2>
            <span class="updated" data-forecast-updated />
          </div>
          <p class="card-sub">{t('forecast.attribution')}</p>
          <div data-widget="hourly-temp">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }

    {
      features.weekOutlook && (
        <section class="card col-12">
          <h2>{t('forecast.week')}</h2>
          <p class="card-sub">{t('forecast.attribution')}</p>
          <div data-widget="week">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }

    {
      features.precipitationChart && (
        <section class="card col-6">
          <h2>{t('forecast.precip')}</h2>
          <p class="card-sub">{t('forecast.attribution')}</p>
          <div data-widget="precip">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }

    {
      features.airQuality && (
        <section class="card col-6">
          <div class="card-head">
            <h2>{t('air.title')}</h2>
            <span class="updated" data-air-updated />
          </div>
          <p class="card-sub">{t('air.subtitle')}</p>
          <div data-widget="air">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
          <p class="card-note">
            {t('air.stationNote')}
            <a href="https://soramame.env.go.jp/" target="_blank" rel="noopener">
              soramame.env.go.jp
            </a>
          </p>
        </section>
      )
    }

    {
      features.measuredAir && (
        <section class="card col-6">
          <div class="card-head">
            <h2>{t('airStation.title')}</h2>
            <span class="updated" data-air-station-updated />
          </div>
          <p class="card-sub">{t('airStation.subtitle')}</p>
          <div data-widget="air-station">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
          <p class="card-note">
            {t('airStation.note')}
            <a href="https://soramame.env.go.jp/" target="_blank" rel="noopener">
              soramame.env.go.jp
            </a>
          </p>
        </section>
      )
    }

    {
      features.pollen && (
        <section class="card col-8">
          <h2>{t('pollen.title')}</h2>
          <p class="card-sub">{t('pollen.subtitle')}</p>
          <div data-widget="pollen">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }

    {
      features.uv && (
        <section class="card col-4">
          <h2>{t('forecast.uv')}</h2>
          <p class="card-sub">{t('forecast.attribution')}</p>
          <div data-widget="uv">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }

    {
      features.crimeStats && (
        <section class="card col-5">
          <div class="card-head">
            <h2>{t('crime.title')}</h2>
            <span class="updated" data-crime-year />
          </div>
          <p class="card-sub">{t('crime.subtitle')}</p>
          <div data-widget="crime">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
          <p class="card-note">
            {t('crime.note')}{' '}
            <a
              href="https://www.pref.nagano.lg.jp/police/toukei/hanzai/opendata.html"
              target="_blank"
              rel="noopener"
            >
              {t('crime.source')}
            </a>
          </p>
        </section>
      )
    }

    {
      features.crimeStats && (
        <section class="card col-7">
          <div class="card-head">
            <h2>{t('crime.topAreas')}</h2>
            <span class="updated" data-crime-year />
          </div>
          <div data-widget="crime-detail">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }

    {
      features.emergencyContacts && (
        <section class="card col-12">
          <div class="card-head">
            <h2>{t('med.title')}</h2>
            {features.medicalPage && (
              <a href={localePath(lang, 'medical')}>{t('med.viewPage')} →</a>
            )}
          </div>
          <p class="card-sub">{t('med.subtitle')}</p>
          <ul class="contact-list">
            <li>
              <a class="tel" href="tel:119">119</a>
              <div class="what">
                <div class="title">{t('med.emergency')}</div>
                <div class="meta">{t('med.emergencyDesc')}</div>
              </div>
            </li>
            <li>
              <a class="tel" href="tel:0263380622">0263-38-0622</a>
              <div class="what">
                <div class="title">{t('med.night')}</div>
                <div class="meta">{t('med.nightDesc')}</div>
              </div>
            </li>
            <li>
              <a class="tel" href="tel:%237119">#7119</a>
              <div class="what">
                <div class="title">{t('med.adult')}</div>
                <div class="meta">{t('med.adultDesc')}</div>
              </div>
            </li>
            <li>
              <a class="tel" href="tel:%238000">#8000</a>
              <div class="what">
                <div class="title">{t('med.child')}</div>
                <div class="meta">{t('med.childDesc')}</div>
              </div>
            </li>
          </ul>
          <p class="card-note">
            {t('med.dutyNote')}
            <a href="https://www.matsu-med.or.jp/" target="_blank" rel="noopener">
              matsu-med.or.jp
            </a>
          </p>
        </section>
      )
    }

    {
      features.quakesPreview && (
        <section class="card col-12">
          <div class="card-head">
            <h2>{t('quakes.title')}</h2>
            {features.earthquakesPage && (
              <a href={localePath(lang, 'earthquakes')}>{t('quakes.viewAll')} →</a>
            )}
          </div>
          <p class="card-sub">{t('quakes.subtitle')}</p>
          <div data-widget="quakes">
            <p class="placeholder">{t('common.loading')}</p>
          </div>
        </section>
      )
    }
  </div>
</Base>

<script>
  import { initDashboard } from '../../lib/dashboard';
  initDashboard();
</script>
