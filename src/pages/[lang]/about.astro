---
import Base from '../../layouts/Base.astro';
import { useTranslations, langParams, asLang } from '../../i18n/utils';

export function getStaticPaths() {
  return langParams;
}

const lang = asLang(Astro.params.lang);
const t = useTranslations(lang);

type L10n = { en: string; ja: string; fr: string };
const same = (s: string): L10n => ({ en: s, ja: s, fr: s });

const sources: { name: L10n; url: string; what: L10n; license: L10n }[] = [
  {
    name: {
      en: 'Japan Meteorological Agency (JMA)',
      ja: '気象庁（JMA）',
      fr: 'Agence météorologique du Japon (JMA)',
    },
    url: 'https://www.jma.go.jp/',
    what: {
      en: 'AMeDAS live observations (Matsumoto station 48361), warnings & advisories (Nagano 200000)',
      ja: 'アメダス実況（松本 48361）、警報・注意報（長野県 200000）',
      fr: 'Observations AMeDAS en direct (station Matsumoto 48361), alertes et avis (Nagano 200000)',
    },
    license: {
      en: 'Free with attribution (Government Standard Terms, CC BY compatible)',
      ja: '出典記載により利用可（政府標準利用規約）',
      fr: 'Utilisation libre avec attribution (conditions standard du gouvernement, compatible CC BY)',
    },
  },
  {
    name: same('Open-Meteo'),
    url: 'https://open-meteo.com/',
    what: {
      en: 'Weather forecast, UV index, and modelled air quality (CAMS)',
      ja: '天気予報・UV指数・大気質モデル値（CAMS）',
      fr: 'Prévisions météo, indice UV et qualité de l’air modélisée (CAMS)',
    },
    license: {
      en: 'Free for non-commercial use, data CC BY 4.0',
      ja: '非商用無料・CC BY 4.0',
      fr: 'Gratuit pour usage non commercial, données CC BY 4.0',
    },
  },
  {
    name: {
      en: 'Weathernews “Pollen Robo” open data',
      ja: 'ウェザーニューズ ポールンロボ',
      fr: 'Données ouvertes « Pollen Robo » de Weathernews',
    },
    url: 'https://wxtech.weathernews.com/',
    what: {
      en: 'Hourly pollen counts (Matsumoto, city code 20202)',
      ja: '花粉観測データ（松本市 20202）',
      fr: 'Comptages horaires de pollens (Matsumoto, code 20202)',
    },
    license: {
      en: 'Attribution required',
      ja: '帰属表示が必要',
      fr: 'Attribution requise',
    },
  },
  {
    name: same('P2P地震情報 (p2pquake.net)'),
    url: 'https://www.p2pquake.net/',
    what: {
      en: 'Earthquake reports (redistribution of JMA bulletins)',
      ja: '地震情報（気象庁発表の再配信）',
      fr: 'Informations sismiques (rediffusion des bulletins JMA)',
    },
    license: {
      en: 'Secondary use permitted',
      ja: '二次利用可',
      fr: 'Réutilisation autorisée',
    },
  },
  {
    name: {
      en: 'Matsumoto City & Matsumoto Anshin-net',
      ja: '松本市・松本安心ネット',
      fr: 'Ville de Matsumoto & Matsumoto Anshin-net',
    },
    url: 'https://www.city.matsumoto.nagano.jp/',
    what: {
      en: 'City news, important-notice and emergency RSS feeds',
      ja: '市の新着・重要・緊急情報RSS',
      fr: 'Flux RSS des actualités, avis importants et urgences de la ville',
    },
    license: {
      en: 'Attribution (city terms, CC BY 4.0-aligned)',
      ja: '出典記載（CC BY 4.0 準拠）',
      fr: 'Attribution (conditions de la ville, alignées CC BY 4.0)',
    },
  },
  {
    name: {
      en: 'Nagano Prefectural Police crime open data',
      ja: '長野県警察 犯罪オープンデータ',
      fr: 'Données ouvertes criminalité de la police de Nagano',
    },
    url: 'https://www.pref.nagano.lg.jp/police/toukei/hanzai/opendata.html',
    what: {
      en: 'Per-incident street-crime records (filtered to Matsumoto, aggregated yearly)',
      ja: '街頭犯罪の認知情報（松本市分を集計・年次）',
      fr: 'Registres des délits de voie publique (filtrés sur Matsumoto, agrégés par an)',
    },
    license: {
      en: 'CC BY 4.0-compatible (police open-data terms)',
      ja: 'CC BY 4.0 準拠（利用規約）',
      fr: 'Compatible CC BY 4.0 (conditions des données ouvertes)',
    },
  },
  {
    name: {
      en: 'Matsumoto City GTFS feeds (via gtfs-data.jp)',
      ja: '松本市 GTFSデータ（GTFSデータリポジトリ経由）',
      fr: 'Flux GTFS de la ville de Matsumoto (via gtfs-data.jp)',
    },
    url: 'https://gtfs-data.jp/',
    what: {
      en: 'City bus routes and stops (Gurutto Matsumoto Bus)',
      ja: '市内バス路線・停留所（ぐるっとまつもとバス）',
      fr: 'Lignes et arrêts des bus municipaux (Gurutto Matsumoto Bus)',
    },
    license: same('CC BY 4.0'),
  },
  {
    name: {
      en: 'GSI designated evacuation site data',
      ja: '国土地理院 指定緊急避難場所データ',
      fr: 'Données GSI des sites d’évacuation désignés',
    },
    url: 'https://www.gsi.go.jp/bousaichiri/hinanbasho.html',
    what: {
      en: 'Emergency evacuation sites for Matsumoto with per-hazard suitability',
      ja: '松本市の指定緊急避難場所（対応災害別）',
      fr: 'Sites d’évacuation d’urgence de Matsumoto, par type de risque',
    },
    license: {
      en: 'Free with attribution (Government Standard Terms)',
      ja: '出典記載により利用可（政府標準利用規約）',
      fr: 'Utilisation libre avec attribution',
    },
  },
  {
    name: {
      en: 'Matsumoto City open data (AED locations)',
      ja: '松本市オープンデータ（AED設置場所）',
      fr: 'Données ouvertes de Matsumoto (emplacements des DAE)',
    },
    url: 'https://www.city.matsumoto.nagano.jp/soshiki/5/4172.html',
    what: {
      en: 'Public AED locations with availability hours',
      ja: 'AED設置場所と利用可能時間',
      fr: 'Emplacements des DAE publics et horaires de disponibilité',
    },
    license: same('CC BY 4.0'),
  },
  {
    name: {
      en: 'Geospatial Information Authority of Japan (GSI)',
      ja: '国土地理院（GSI）',
      fr: 'Autorité d’information géospatiale du Japon (GSI)',
    },
    url: 'https://maps.gsi.go.jp/',
    what: { en: 'Map tiles', ja: '地図タイル', fr: 'Fonds de carte' },
    license: {
      en: 'Free with attribution',
      ja: '出典記載により利用可',
      fr: 'Utilisation libre avec attribution',
    },
  },
];

const colWhat = { en: 'Data used', ja: '利用データ', fr: 'Données utilisées' }[lang];
const colLicense = { en: 'License', ja: 'ライセンス', fr: 'Licence' }[lang];
const builtWith = {
  en: 'Built with Astro and served for free on GitHub Pages. The source code is open.',
  ja: 'このサイトはAstroで構築され、GitHub Pagesで無料配信されています。ソースコードは公開されています。',
  fr: 'Construit avec Astro et hébergé gratuitement sur GitHub Pages. Le code source est ouvert.',
}[lang];
---

<Base lang={lang} title={t('about.title')} active="about">
  <h1 class="page-title">{t('about.title')}</h1>
  <p class="page-sub">{t('site.description')}</p>

  <div class="prose">
    <section class="card">
      <p style="margin: 0">{t('about.disclaimer')}</p>
    </section>

    <h2>{t('about.dataTitle')}</h2>
    <div class="card table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th>{t('common.source')}</th>
            <th>{colWhat}</th>
            <th>{colLicense}</th>
          </tr>
        </thead>
        <tbody>
          {
            sources.map((s) => (
              <tr>
                <td>
                  <a href={s.url} target="_blank" rel="noopener">
                    {s.name[lang]}
                  </a>
                </td>
                <td>{s.what[lang]}</td>
                <td>{s.license[lang]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="card-note">{t('about.updatedNote')}</p>
    <p class="card-note">{builtWith}</p>
  </div>
</Base>
