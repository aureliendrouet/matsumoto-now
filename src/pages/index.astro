---
// Root page: redirect to the visitor's preferred language.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Matsumoto Now · 松本なう</title>
    {/* This page only redirects to the visitor's language; /en/ is the real, indexable homepage. */}
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(`${base}/en/`, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline define:vars={{ base }}>
      const supported = ['en', 'ja', 'fr', 'es', 'pt', 'it', 'de', 'no', 'zh', 'ko', 'tl', 'vi', 'th'];
      let lang = null;
      try {
        lang = localStorage.getItem('lang');
      } catch {}
      if (!supported.includes(lang)) {
        const nav = (navigator.language || 'en').toLowerCase();
        // browser tags that differ from our slugs
        const alias = { nb: 'no', nn: 'no', fil: 'tl' };
        const prefix = Object.keys(alias).find((p) => nav.startsWith(p));
        lang = prefix ? alias[prefix] : supported.find((l) => nav.startsWith(l)) ?? 'en';
      }
      location.replace(`${base}/${lang}/`);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${base}/en/`} />
    </noscript>
  </head>
  <body>
    <p style="font-family: system-ui; padding: 2rem">
      <a href={`${base}/en/`}>English</a> · <a href={`${base}/ja/`}>日本語</a> ·
      <a href={`${base}/fr/`}>Français</a> · <a href={`${base}/es/`}>Español</a> ·
      <a href={`${base}/pt/`}>Português</a> · <a href={`${base}/it/`}>Italiano</a> ·
      <a href={`${base}/de/`}>Deutsch</a> · <a href={`${base}/no/`}>Norsk</a> ·
      <a href={`${base}/zh/`}>中文</a> · <a href={`${base}/ko/`}>한국어</a> ·
      <a href={`${base}/tl/`}>Filipino</a> · <a href={`${base}/vi/`}>Tiếng Việt</a> ·
      <a href={`${base}/th/`}>ไทย</a>
    </p>
  </body>
</html>
